# Real values live in Vercel → roofing-solutions-tasks → Settings → Environment Variables.
# Pull them locally with:  vercel env pull .env.local
USER_PINS={"Loriale":"00000000","Mayer":"00000001","Mrs. Salcer":"00000002","Ben":"00000003","Mr. Klein":"00000004","Yehuda":"00000005"}
AUTH_SECRET=any-long-random-string
BLOB_READ_WRITE_TOKEN=

# --- Optional: automatic customer text reminders (Twilio) ---
# Without these the app still works; "Text reminder" opens the phone's own Messages app instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=   (use instead of TWILIO_FROM if you have a messaging service)
# Any long random string. Vercel sends it with the nightly cron call so nobody else can trigger texts.
CRON_SECRET=
# Time zone used for "tomorrow" in reminders (default America/New_York).
BUSINESS_TZ=America/New_York

# --- Optional: more accurate address suggestions ---
# Without this, suggestions come from the free OpenStreetMap service (some house numbers are missing).
# With a Google Maps Platform key (Places API (New) enabled) suggestions match Google Maps.
GOOGLE_MAPS_KEY=
